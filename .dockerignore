!.git/HEAD
!.git/refs
!.git/packed-refs
**/node_modules
**/.next
**/out
**/.env
**/.env.*
**/*.key
**/*.pem
**/*.tar.gz
**/logs
screenshots
deploy/credentials
deploy/bundle-tmp
hoja-site/audits
hoja-site/scripts
.workbuddy-ai
.tmp_*
