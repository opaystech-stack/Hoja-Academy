# ─── OPAYS Classroom Gateway — variables d'environnement ───────────────
# Copier ce fichier vers /opt/opays-classroom-gateway/.env sur le VPS et
# renseigner les valeurs. NE JAMAIS committer ce fichier rempli.
#
# (Dans Dokploy : renseigner les mêmes variables dans l'application
#  opays-classroom-gateway → onglet « Environnement ».)

# OAuth Google (Google Cloud Console → Credentials → OAuth Client Web)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Auth Basic admin (accès aux endpoints /oauth et /api)
ADMIN_USER=admin
ADMIN_PASS=

# URL publique du site (le callback sera /oauth/callback)
REDIRECT_BASE=https://course.opays.io

# Emails Google autorisés à s'authentifier (séparés par des virgules).
# VIDE = premier compte connecté accepté (bootstrap) — à restreindre ensuite.
ALLOWED_ADMIN_EMAILS=
