    "classroom:kit": "node scripts/generate_classroom_posts.js",
    "check:classroom": "node scripts/check_classroom_kit.js",
    "build:public": "node scripts/build_public.js",
    "test:public": "node scripts/test_public.js",
    "build:site": "node scripts/build_hoja_site.js",
    "test:site": "node scripts/test_hoja_site.js",
    "audit:design": "node scripts/audit_design_site.js",
    "typo:inventory": "node scripts/typo_inventory.js",
    "typo:normalize": "node scripts/normalize_typography.js",
    "typo:capture": "node scripts/typo_capture.js",
    "typo:compare": "node scripts/typo_compare.js",
    "ditto:analyze": "node scripts/analyze_ditto.js",
    "ditto:clean": "node scripts/clean_ditto.js",
    "audit:ui": "node scripts/audit_ui.js",
    "capture:ui": "node scripts/capture_ui.js",
    "clean:site-fonts": "node scripts/clean_hoja_fonts.js",
    "test:parcours": "node scripts/test_parcours_apprenant.js",
    "test:formateur": "node scripts/test_parcours_formateur.js",
    "build:admin": "node scripts/build_admin.js",
    "build:landing": "node scripts/build_landing.js",
    "test:prod": "node scripts/test_production_remote.js",
    "test:admin": "node scripts/test_parcours_formateur_admin.js",
    "mock:2b": "node scripts/mock_api_2b.js",
    "test:identity": "node scripts/test_identity_2b.js",
    "test:e2e": "node scripts/test_e2e_2b.js"
